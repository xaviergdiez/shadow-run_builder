# Copy to .env.local and fill in. Only needed for `vercel dev` and deploys —
# `npm run dev` runs without any of it (stubbed sign-in, localStorage runners,
# no portrait generation).

# Upstash Redis. Redis.fromEnv() reads exactly these two names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in. Authorized redirect URI: <your app URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only address allowed to sign in.
OWNER_EMAIL=

# Portrait generation (api/generate-avatar.js). Without it that endpoint 500s;
# everything else still works.
GEMINI_API_KEY=
